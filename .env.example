PORT=3000
NODE_ENV=development

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pssm_accommodation
DB_USER=
DB_PASSWORD=

# JWT (roles: Admin, Hotel Receptionist, Visitor)
JWT_SECRET=
JWT_EXPIRES_IN=8h

# File storage for live photos and ID proofs: local | s3 | cloudinary
FILE_STORAGE=local
UPLOAD_DIR=uploads

# WhatsApp (primary notification channel)
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# Standard stay times
CHECKIN_TIME=11:00
CHECKOUT_TIME=11:00
